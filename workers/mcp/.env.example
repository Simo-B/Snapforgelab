# Environment variables & secrets for workers/mcp/ (mcp.snapforgelab.com)
# For local development with `npx wrangler dev`, copy this file to `.dev.vars` (gitignored).
# In production, set secrets via `npx wrangler secret put <NAME>`.

# Public OpenAI Apps verification token served at /.well-known/openai-apps-challenge
OPENAI_APPS_CHALLENGE=

# PayPal REST API v2 credentials (https://developer.paypal.com/dashboard/applications)
# Set PAYPAL_ENV=sandbox for testing or PAYPAL_ENV=live for production
PAYPAL_ENV=live
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Server-side HMAC secret used to derive private report access keys (32+ random hex chars)
# Generate one with:  openssl rand -hex 32
REPORT_SECRET=

# Server-enforced report price (integer cents; 1900 = $19.00 USD)
REPORT_PRICE_CENTS=1900
REPORT_CURRENCY=USD

# Resend API key for automatic report-link delivery emails (https://resend.com/api-keys)
RESEND_API_KEY=
RESEND_FROM="Simo — Snapforge Lab <hello@snapforgelab.com>"
